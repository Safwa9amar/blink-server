{
  "name": "blink-server",
  "version": "1.0.29",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:arch": "tsx watch --env-file=.env.arch.local src/index.ts",
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:arch": "sh scripts/deploy-arch.sh",
    "sync:arch": "sh scripts/sync-arch.sh",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "start": "node dist/index.js",
    "db:init": "npx supabase init",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:migrate": "npx supabase migration new",
    "db:push": "npx supabase db push",
    "db:types": "npx supabase gen types typescript --local > src/types/supabase.ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:pull": "drizzle-kit pull",
    "drizzle:studio": "drizzle-kit studio",
    "apple:secret": "node scripts/gen-apple-secret.mjs",
    "apple:proxy": "node scripts/apple-domain-proxy.mjs",
    "openapi": "tsx scripts/gen-openapi.ts",
    "seed:dev-users": "tsx scripts/seed-dev-users.ts",
    "seed:dev-merchant": "tsx scripts/seed-dev-merchant.ts",
    "seed:dev-agents": "tsx scripts/seed-dev-agents.ts",
    "test:order": "tsx scripts/trigger-test-order.ts",
    "test:checkout": "tsx scripts/trigger-test-checkout.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "@hono/zod-openapi": "^1.6.3",
    "@supabase/supabase-js": "^2.105.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "expo-server-sdk": "^3.15.0",
    "hono": "^4.12.18",
    "imapflow": "^1.4.6",
    "mailparser": "^3.9.14",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0",
    "tsx": "^4.22.0",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.8.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.21.0",
    "typescript": "^6.0.3"
  }
}
